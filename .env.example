# Скопируй в .env и заполни значения.

# ── Postgres ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme              # пароль пользователя cloud

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme               # `openssl rand -hex 32`
JWT_ACCESS_TTL=15m                # время жизни access-токена
JWT_REFRESH_TTL=720h              # время жизни refresh-токена (30 дней)

# ── Cookies ───────────────────────────────────────────────────────────────────
REFRESH_COOKIE_SECURE=true        # false только для локальной разработки без HTTPS
REFRESH_COOKIE_SAMESITE=lax       # lax / strict / none

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=changeme         # root-логин MinIO
MINIO_SECRET_KEY=changeme         # root-пароль MinIO
MINIO_BUCKET=blobs                # имя бакета для файлов
MINIO_REGION=us-east-1            # регион (влияет только на заголовки S3 API)
MINIO_PRESIGN_TTL=1h              # срок действия presigned URL
MINIO_PUBLIC_ENDPOINT=https://s3.example.com   # URL MinIO как его видит браузер
MINIO_SERVER_URL=https://s3.example.com        # URL MinIO за reverse proxy (для presigned URL)
MINIO_API_CORS_ALLOW_ORIGIN=https://app.example.com  # разрешённые origins для S3 API

# ── Хранилище ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=0                # макс. размер файла в байтах; 0 = без ограничений
STORAGE_QUOTA_BYTES=0             # квота на пользователя в байтах; 0 = без ограничений
TRASH_TTL=720h                    # через сколько файлы из корзины удаляются навсегда

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=                   # API-ключ Resend; пустой — уведомления отключены
SMTP_FROM=noreply@example.com     # адрес отправителя

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://app.example.com  # origin фронтенда для CORS

# ── Прочее ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info                    # debug / info / warn / error
